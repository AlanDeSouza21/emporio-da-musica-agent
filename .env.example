# Required: get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here

# Optional: default model
# GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: comma-separated list of models used as fallback
# GEMINI_MODELS=model-a,model-b

# Optional: override today's date for testing (YYYY-MM-DD)
# TODAY_OVERRIDE=2026-11-12